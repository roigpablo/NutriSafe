<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Antes de empezar"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="NutriSafe te ayuda a valorar si un producto encaja con tu perfil (alergias, celiaquía o diabetes), pero es una herramienta orientativa. No sustituye el consejo de un profesional sanitario ni la lectura de la etiqueta del producto."
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Los datos de los productos proceden de Open Food Facts, una base colaborativa que puede ser incompleta o contener errores. Si un dato falta, la app lo indica con el color gris."
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tu perfil se guarda únicamente en este dispositivo y no se envía a ningún servidor."
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbAcepto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="He leído y acepto este aviso" />

        <Button
            android:id="@+id/btnContinuar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="Continuar" />
    </LinearLayout>
</ScrollView>