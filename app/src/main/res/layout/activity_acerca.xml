<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acerca de NutriSafe"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Versión 1.0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="NutriSafe es un proyecto académico del Grado Superior de Desarrollo de Aplicaciones Multiplataforma. La información es orientativa y no sustituye el consejo médico ni la lectura de la etiqueta del producto."
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Datos de productos"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autoLink="web"
            android:text="Los datos de productos proceden de Open Food Facts (https://world.openfoodfacts.org), una base de datos colaborativa publicada bajo la licencia Open Database License (ODbL). Las imágenes se publican bajo la licencia CC BY-SA. Al ser colaborativa, puede contener datos incompletos o erróneos."
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>